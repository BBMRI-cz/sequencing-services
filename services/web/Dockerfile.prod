###########
# BUILDER #
###########

# pull official base image
FROM python:3.11.3-slim-buster as builder

# set work directory
WORKDIR /usr/src/app

# set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# ponytail: no gcc — every requirement ships a cp311 manylinux wheel, so nothing
# is compiled from source here. Debian buster is EOL and its apt repos are gone,
# so installing it is no longer possible anyway. If a future dependency has no
# wheel, `pip wheel` will fail loudly at build time: move to a supported base
# image (python:3.11-slim-bookworm) rather than reinstating apt on buster.

# install dependencies
RUN pip install --upgrade pip
COPY . /usr/src/app/


COPY ./requirements.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /usr/src/app/wheels -r requirements.txt

#########
# FINAL #
#########

FROM python:3.11.3-slim-buster

RUN mkdir -p /home/app

RUN addgroup --system --gid 1000 app && adduser --system --uid 1004 --group app

ENV HOME=/home/app
ENV APP_HOME=/home/app/web
RUN mkdir $APP_HOME
WORKDIR $APP_HOME

# ponytail: no netcat — entrypoint.sh waits for postgres with the stdlib socket
# module instead, which is already in the image. Same reason as above: buster's
# apt repos are gone, and the package was renamed netcat-openbsd after buster.
COPY --from=builder  /usr/src/app/wheels /wheels
COPY --from=builder /usr/src/app/requirements.txt .

RUN pip install --upgrade pip
RUN pip install --no-cache /wheels/*

COPY ./entrypoint.sh $APP_HOME

COPY . $APP_HOME

RUN chown -R app:app $APP_HOME

USER app

ENTRYPOINT ["/home/app/web/entrypoint.sh"]